{
  "name": "jee",
  "private": true,
  "type": "module",
  "version": "3.0.0",
  "description": "JEE Main 2027 — syllabus, percentile-to-rank conversion, and seven years of JoSAA cut-offs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "data": "node tools/build-data.mjs",
    "reports": "node tools/build-reports.mjs",
    "build:all": "node tools/build-data.mjs && node tools/build-reports.mjs && vite build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
